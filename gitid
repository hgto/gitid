#!/usr/bin/env sh
set -eu

GITID_DIR="${GITID_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/git}"

die() { printf 'gitid: %s\n' "$1" >&2; exit "${2:-1}"; }
in_repo() { git rev-parse --is-inside-work-tree >/dev/null 2>&1; }

list_names() {
  for p in "$GITID_DIR"/*.gitconfig; do
    [ -f "$p" ] || continue
    b=${p##*/}; printf '%s\n' "${b%.gitconfig}"
  done
}

# escape ERE metacharacters; uses `#` as the sed delimiter so `/` in paths needs no escaping.
# `]` is first in the bracket so it is literal; the set covers the chars that can appear in a path.
ere_escape() { printf '%s' "$1" | sed 's#[][(){}.^$*+?|\\]#\\&#g'; }
identity_file() { printf '%s/%s.gitconfig' "$GITID_DIR" "$1"; }

strip_local_identity() {
  for key in user.name user.email user.signingkey github.user; do
    git config --local --unset-all "$key" 2>/dev/null || :
  done
}

hooks_dir() { printf '%s/hooks' "$GITID_DIR"; }

# resolve $0 through any symlink chain to the real script's absolute path
self_path() {
  self="$0"
  while [ -h "$self" ]; do
    # shellcheck disable=SC1007
    sdir="$(CDPATH= cd "$(dirname "$self")" && pwd)"
    link="$(readlink "$self")"
    case "$link" in
      /*) self="$link" ;;
      *)  self="$sdir/$link" ;;
    esac
  done
  # shellcheck disable=SC1007
  sdir="$(CDPATH= cd "$(dirname "$self")" && pwd)"
  printf '%s/%s' "$sdir" "${self##*/}"
}

snippet_enforced() {
  [ -f "$1" ] || return 1
  [ "$(git config -f "$1" --bool gitid.enforce 2>/dev/null || printf false)" = "true" ]
}

cmd_apply() {
  name="$1"
  f="$(identity_file "$name")"
  [ -f "$f" ] || die "no identity file: $f"
  in_repo || die "not in a git repo"
  strip_local_identity
  pat="^$(ere_escape "$GITID_DIR")/.*\.gitconfig\$"
  git config --local --unset-all include.path "$pat" 2>/dev/null || :
  git config --local --add include.path "$f"
  printf 'gitid: %s applied\n' "$name"
}

active_identity() {
  git config --local --get-all include.path 2>/dev/null | while IFS= read -r v; do
    case "$v" in
      "$GITID_DIR"/*.gitconfig) b=${v##*/}; printf '%s' "${b%.gitconfig}"; return 0 ;;
    esac
  done
}

cmd_show() {
  in_repo || die "not in a git repo"
  act="$(active_identity)"; [ -n "$act" ] || act="(none / inherited)"
  printf 'name:   %s\n' "$(git config user.name 2>/dev/null || printf '(unset)')"
  printf 'email:  %s\n' "$(git config user.email 2>/dev/null || printf '(unset)')"
  printf 'active: %s\n' "$act"
  snippet_enforced "$(identity_file "$act")" && printf 'enforce: yes\n'
  if git config --local --get user.email >/dev/null 2>&1 \
     || git config --local --get user.name >/dev/null 2>&1; then
    printf 'gitid: warning: inline local identity present; it shadows includes\n' >&2
  fi
}

repo_urls() {
  in_repo || return 0
  git config --get-regexp '^remote\..*\.url$' 2>/dev/null | while read -r _ u; do printf '%s\n' "$u"; done
}

rule_glob() { g=${1#includeif.}; g=${g%.path}; printf '%s' "${g##*url:}"; }

cmd_rules() {
  urls="$(repo_urls)"
  git config --get-regexp '^includeif\..*\.path$' 2>/dev/null | while IFS= read -r line; do
    key=${line%% *}; val=${line#* }
    glob="$(rule_glob "$key")"
    nm=${val##*/}; nm=${nm%.gitconfig}
    mark="  "
    for u in $urls; do
      # shellcheck disable=SC2254
      case "$u" in $glob) mark="▸ "; break ;; esac
    done
    tag=""
    snippet_enforced "$(expand_tilde "$val")" && tag=" [enforced]"
    printf '%s%s -> %s%s\n' "$mark" "$glob" "$nm" "$tag"
  done
}

# shellcheck disable=SC2088
expand_tilde() { case "$1" in "~/"*) printf '%s/%s' "$HOME" "${1#"~/"}" ;; *) printf '%s' "$1" ;; esac; }

expected_identity_file() {
  urls="$(repo_urls)"
  [ -n "$urls" ] || return 0
  git config --get-regexp '^includeif\..*\.path$' 2>/dev/null | while IFS= read -r line; do
    key=${line%% *}; val=${line#* }
    glob="$(rule_glob "$key")"
    for u in $urls; do
      # shellcheck disable=SC2254
      case "$u" in $glob) printf '%s' "$val"; return 0 ;; esac
    done
  done
}

cmd_check() {
  in_repo || die "not in a git repo"
  eff="$(git config user.email 2>/dev/null || true)"
  exp_file="$(expected_identity_file)"
  if [ -z "$exp_file" ]; then
    [ -n "$eff" ] && { printf 'gitid: ok (no rule matches; identity=%s)\n' "$eff"; return 0; }
    die "no identity set and no matching rule"
  fi
  exp_email="$(git config -f "$(expand_tilde "$exp_file")" user.email 2>/dev/null || true)"
  if [ "$eff" = "$exp_email" ] && [ -n "$eff" ]; then
    printf 'gitid: ok (%s)\n' "$eff"; return 0
  fi
  nm=${exp_file##*/}; nm=${nm%.gitconfig}
  printf 'gitid: identity mismatch: effective=%s expected=%s\n  fix: gitid %s\n' "${eff:-(unset)}" "$exp_email" "$nm" >&2
  return 1
}

cmd_migrate() {
  apply=0; dir="."
  for a in "$@"; do
    case "$a" in --apply) apply=1 ;; *) dir="$a" ;; esac
  done
  find "$dir" -type d -name .git 2>/dev/null | while IFS= read -r g; do
    repo=${g%/.git}
    had=""
    for key in user.name user.email user.signingkey github.user; do
      v="$(git -C "$repo" config --local --get "$key" 2>/dev/null || true)"
      [ -n "$v" ] && had="$had $key"
    done
    if [ -z "$had" ]; then printf 'clean       %s\n' "$repo"; continue; fi
    if [ "$apply" -eq 1 ]; then
      for key in user.name user.email user.signingkey github.user; do
        git -C "$repo" config --local --unset-all "$key" 2>/dev/null || :
      done
      printf 'cleaned     %s (%s )\n' "$repo" "$had"
    else
      printf 'would-clean %s (%s )\n' "$repo" "$had"
    fi
  done
}

global_config_file() {
  if [ -n "${GIT_CONFIG_GLOBAL:-}" ]; then printf '%s' "$GIT_CONFIG_GLOBAL"
  elif [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/git/config" ]; then printf '%s' "${XDG_CONFIG_HOME:-$HOME/.config}/git/config"
  else printf '%s' "$HOME/.gitconfig"; fi
}

cmd_migrate_global() {
  apply=0; for a in "$@"; do [ "$a" = "--apply" ] && apply=1; done
  files="$(global_config_file)"
  # add files referenced by UNCONDITIONAL include.path (never includeif.*.path)
  inc="$(git config --global --get-all include.path 2>/dev/null || true)"
  for p in $inc; do files="$files
$(expand_tilde "$p")"; done
  printf '%s\n' "$files" | while IFS= read -r fpath; do
    if [ -z "$fpath" ] || [ ! -f "$fpath" ]; then continue; fi
    had=""
    for key in user.name user.email user.signingkey github.user; do
      v="$(git config -f "$fpath" --get "$key" 2>/dev/null || true)"
      [ -n "$v" ] && had="$had $key"
    done
    if [ -z "$had" ]; then printf 'clean       %s\n' "$fpath"; continue; fi
    if [ "$apply" -eq 1 ]; then
      for key in user.name user.email user.signingkey github.user; do
        git config -f "$fpath" --unset-all "$key" 2>/dev/null || :
      done
      printf 'cleaned     %s (%s )\n' "$fpath" "$had"
    else
      printf 'would-clean %s (%s )\n' "$fpath" "$had"
    fi
  done
}

cmd_enforce() {
  name="${1:-}"; [ -n "$name" ] || die "enforce: specify an identity"
  f="$(identity_file "$name")"; [ -f "$f" ] || die "no identity file: $f"
  git config -f "$f" gitid.enforce true
  printf 'gitid: %s enforced\n' "$name"
}

cmd_unenforce() {
  name="${1:-}"; [ -n "$name" ] || die "unenforce: specify an identity"
  f="$(identity_file "$name")"; [ -f "$f" ] || die "no identity file: $f"
  git config -f "$f" --unset gitid.enforce 2>/dev/null || :
  printf 'gitid: %s unenforced\n' "$name"
}

# enforcement policy invoked by the pre-commit dispatcher: fail only when the
# repo's remote matches a rule whose identity is enforced and the effective
# identity differs. No matching rule / rule not enforced -> pass (the
# useConfigOnly floor covers the no-identity case).
cmd_guard_check() {
  in_repo || return 0
  exp_file="$(expected_identity_file)"
  [ -n "$exp_file" ] || return 0
  exp_path="$(expand_tilde "$exp_file")"
  snippet_enforced "$exp_path" || return 0
  eff="$(git config user.email 2>/dev/null || true)"
  exp_email="$(git config -f "$exp_path" user.email 2>/dev/null || true)"
  [ "$eff" = "$exp_email" ] && [ -n "$eff" ] && return 0
  nm=${exp_file##*/}; nm=${nm%.gitconfig}
  printf 'gitid: identity mismatch (enforced): effective=%s expected=%s\n  fix: gitid %s\n' \
    "${eff:-(unset)}" "$exp_email" "$nm" >&2
  return 1
}

# client-side hook names installed as dispatchers so a global core.hooksPath
# never silently shadows a prior global hook or a repo-local .git/hooks entry.
# The specialized long-running/vendor hooks (fsmonitor-watchman, p4-*) are
# deliberately omitted — they take non-standard args a generic dispatcher can't
# safely pass through.
DISPATCH_HOOKS='applypatch-msg pre-applypatch post-applypatch pre-commit pre-merge-commit prepare-commit-msg commit-msg post-commit pre-rebase post-checkout post-merge pre-auto-gc pre-push post-rewrite post-index-change reference-transaction push-to-checkout sendemail-validate'

write_dispatcher() {
  hd="$1"
  cat > "$hd/gitid-dispatch" <<'HOOK'
#!/usr/bin/env sh
# Managed by `gitid guard`. Do not edit.
# On pre-commit: enforce gitid identity rules. Always: chain the same-named
# hook from the previous global hooks dir and the repo-local .git/hooks, so
# core.hooksPath doesn't silently shadow them.
set -u
hook=${0##*/}

# Only these hooks receive meaningful stdin. Capturing it for the others (e.g.
# pre-commit) would `cat`-block forever when the commit runs as a subprocess
# with an inherited open pipe as stdin — hanging every commit.
stdin_file=
case "$hook" in
  pre-push|post-rewrite|reference-transaction|push-to-checkout)
    if [ ! -t 0 ]; then
      stdin_file=$(mktemp)
      cat >"$stdin_file"
    fi
    ;;
esac
cleanup() { [ -n "$stdin_file" ] && rm -f "$stdin_file"; }
feed() { if [ -n "$stdin_file" ]; then "$@" <"$stdin_file"; else "$@"; fi; }

if [ "$hook" = pre-commit ]; then
  bin=$(git config --global --get gitid.bin 2>/dev/null || true)
  [ -x "$bin" ] || bin=$(command -v gitid 2>/dev/null || true)
  if [ -z "$bin" ]; then
    printf 'gitid: guard hook cannot locate the gitid binary; refusing commit\n' >&2
    printf '  set gitid.bin, fix PATH, or run: gitid guard uninstall\n' >&2
    cleanup; exit 1
  fi
  "$bin" guard check || { cleanup; exit 1; }
fi

prev=$(git config --global --get gitid.prevHooksPath 2>/dev/null || true)
gitdir=$(git rev-parse --absolute-git-dir 2>/dev/null || true)
repo=
[ -n "$gitdir" ] && repo="$gitdir/hooks"
for dir in "$prev" "$repo"; do
  [ -n "$dir" ] || continue
  h="$dir/$hook"
  if [ -x "$h" ]; then
    feed "$h" "$@" || { st=$?; cleanup; exit "$st"; }
  fi
done
cleanup
exit 0
HOOK
  chmod +x "$hd/gitid-dispatch"
  for name in $DISPATCH_HOOKS; do
    ln -sf gitid-dispatch "$hd/$name"
  done
}

cmd_guard_install() {
  hd="$(hooks_dir)"
  git config --global user.useConfigOnly true
  git config --global gitid.bin "$(self_path)"
  prev="$(git config --global --get core.hooksPath 2>/dev/null || true)"
  if [ -n "$prev" ] && [ "$prev" != "$hd" ]; then
    git config --global gitid.prevHooksPath "$prev"
  fi
  mkdir -p "$hd"
  write_dispatcher "$hd"
  git config --global core.hooksPath "$hd"
  printf 'gitid: guard installed (useConfigOnly=true, hooksPath=%s)\n' "$hd"
}

cmd_guard_uninstall() {
  all=0
  for a in "$@"; do [ "$a" = "--all" ] && all=1; done
  hd="$(hooks_dir)"
  cur="$(git config --global --get core.hooksPath 2>/dev/null || true)"
  if [ "$cur" = "$hd" ]; then
    prev="$(git config --global --get gitid.prevHooksPath 2>/dev/null || true)"
    if [ -n "$prev" ]; then
      git config --global core.hooksPath "$prev"
    else
      git config --global --unset core.hooksPath 2>/dev/null || :
    fi
  fi
  git config --global --unset gitid.prevHooksPath 2>/dev/null || :
  git config --global --unset gitid.bin 2>/dev/null || :
  [ -d "$hd" ] && rm -rf "$hd"
  [ "$all" -eq 1 ] && git config --global --unset user.useConfigOnly 2>/dev/null || :
  printf 'gitid: guard uninstalled\n'
}

cmd_guard_status() {
  hd="$(hooks_dir)"
  uco="$(git config --global --bool user.useConfigOnly 2>/dev/null || printf false)"
  cur="$(git config --global --get core.hooksPath 2>/dev/null || true)"
  printf 'useConfigOnly: %s\n' "$uco"
  if [ "$cur" = "$hd" ]; then
    printf 'hooksPath:     %s (gitid)\n' "$cur"
  elif [ -n "$cur" ]; then
    printf 'hooksPath:     %s (not gitid)\n' "$cur"
  else
    printf 'hooksPath:     (unset)\n'
  fi
  if [ -x "$hd/pre-commit" ]; then
    printf 'dispatcher:    installed\n'
  else
    printf 'dispatcher:    missing\n'
  fi
  prev="$(git config --global --get gitid.prevHooksPath 2>/dev/null || true)"
  [ -n "$prev" ] && printf 'chains to:     %s\n' "$prev"
  return 0
}

cmd_guard() {
  sub="${1:-status}"
  [ $# -gt 0 ] && shift
  case "$sub" in
    install)   cmd_guard_install "$@" ;;
    uninstall) cmd_guard_uninstall "$@" ;;
    status)    cmd_guard_status "$@" ;;
    check)     cmd_guard_check "$@" ;;
    *) die "guard: unknown subcommand: $sub (install|uninstall|status|check)" ;;
  esac
}

cmd_completion() {
  # Resolve $0 through any symlink chain (e.g. ~/bin/gitid -> .../vendor/gitid/gitid)
  # so completion/ files are found next to the real script, not next to the link.
  here="$(dirname "$(self_path)")"
  case "${1:-}" in
    bash) cat "$here/completion/gitid.bash" ;;
    zsh)  cat "$here/completion/gitid.zsh" ;;
    *) die "completion: specify bash or zsh" ;;
  esac
}

cmd_help() {
  printf 'usage: gitid <name>|show|rules|check|enforce <name>|unenforce <name>\n'
  printf '             |guard <install|uninstall|status>\n'
  printf '             |migrate [dir]|migrate-global|completion <bash|zsh>\n'
  printf '  GITID_DIR=%s\n' "$GITID_DIR"
  printf 'identities:\n'
  list_names | sed 's/^/  /'
}

main() {
  cmd="${1:-help}"
  case "$cmd" in
    help|-h|--help|"") cmd_help ;;
    show) shift; cmd_show "$@" ;;
    rules) shift; cmd_rules "$@" ;;
    check) shift; cmd_check "$@" ;;
    enforce) shift; cmd_enforce "$@" ;;
    unenforce) shift; cmd_unenforce "$@" ;;
    guard) shift; cmd_guard "$@" ;;
    migrate) shift; cmd_migrate "$@" ;;
    migrate-global) shift; cmd_migrate_global "$@" ;;
    completion) shift; cmd_completion "$@" ;;
    *) cmd_apply "$cmd" ;;
  esac
}

main "$@"
